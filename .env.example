# ==========================================
# Web Data Forge - Environment Configuration
# ==========================================
# Copy this file to .env and replace placeholders with real values.
# NEVER commit your actual .env file to version control.

# AI Planner Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Application Environment (development | testing | production)
APP_ENV=development
LOG_LEVEL=INFO

# Network & Extraction Guardrails
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=5242880 # 5 MB maximum page size
USER_AGENT=WebDataForgeBot/0.1.0 (+https://github.com/your-username/Web-Data-Forge)

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./data/web_data_forge.db
